
// rspc default theme. Derived from the rmpc 0.11 theme layout.
#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    format_tag_separator: " | ",
    browser_column_widths: [20, 38, 42],
    background_color: Some("#101010"),
    join_borders: true,
    text_color: Some("#d4d4d4"),
    header_background_color: Some("#252525"),
    modal_background_color: Some("#1e1e1e"),
    modal_backdrop: false,
    preview_label_style: (fg: "#eeeeee"),
    preview_metadata_group_style: (fg: "#eeeeee", modifiers: "Bold"),
    highlighted_item_style: (fg: "#b0b0b0", modifiers: "Bold"),
    current_item_style: (fg: "#ffffff", bg: "#3a3a3a", modifiers: "Bold"),
    borders_style: (fg: "#4a4a4a"),
    highlight_border_style: (fg: "#707070"),
    symbols: (
        song: "S",
        dir: "D",
        playlist: "P",
        marker: "M",
        ellipsis: "...",
        song_style: None,
        dir_style: None,
        playlist_style: None,
    ),
    level_styles: (
        info: (fg: "#b0b0b0", bg: "#252525"),
        warn: (fg: "#eeeeee", bg: "#252525"),
        error: (fg: "#eeeeee", bg: "#252525"),
        debug: (fg: "#b0b0b0", bg: "#252525"),
        trace: (fg: "#909090", bg: "#252525"),
    ),
    progress_bar: (
        symbols: ["━", "━", "╸", "─", "━"],
        track_style: (fg: "#404040", bg: "#191919"),
        elapsed_style: (fg: "#b0b0b0", bg: "#191919"),
        thumb_style: (fg: "#b0b0b0", bg: "#191919"),
        use_track_when_empty: true,
    ),
    scrollbar: None,
    tab_bar: (
        fill: false,
        padding: 1,
        min_width: 0,
        alignment: Center,
        active_style: (fg: "#f0f0f0", bg: "#292929", modifiers: "Bold"),
        inactive_style: (fg: "#858585", bg: "#101010"),
    ),
    lyrics: (
        timestamp: false
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist)),
                (kind: Text(" - ")),
                (kind: Property(Title)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
    song_table_column_spacing: 2,
    song_table_format: [
        (
            prop: (kind: Property(Artist),
                default: (kind: Text("Unknown"))
            ),
            label_prop: (kind: Text("Artist")),
            width: "24%",
        ),
        (
            prop: (kind: Property(Title),
                default: (kind: Text("Unknown"))
            ),
            label_prop: (kind: Text("Title")),
            width: "36%",
        ),
        (
            prop: (kind: Property(Album), style: (fg: "#d4d4d4"),
                default: (kind: Text("Unknown Album"), style: (fg: "#d4d4d4"))
            ),
            label_prop: (kind: Text("Album")),
            width: "32%",
        ),
        (
            prop: (kind: Property(Duration),
                default: (kind: Text("-"))
            ),
            label_prop: (kind: Text("Time")),
            width: "8%",
            alignment: Right,
        ),
    ],
    layout: Split(
        direction: Vertical,
        panes: [
            (
                size: "1",
                background_color: "#191919",
                pane: Split(direction: Horizontal, panes: [
                    (size: "10", pane: Component("state")),
                    (size: "1", pane: Component("separator")),
                    (size: "1", pane: Pane(Empty())),
                    (size: "100%", pane: Component("song_info")),
                    (size: "1", pane: Pane(Empty())),
                    (size: "1", pane: Component("separator")),
                    (size: "10", pane: Component("volume")),
                ]),
            ),
            (
                size: "2",
                borders: "BOTTOM",
                border_symbols: Plain,
                border_style: (fg: "#303030"),
                pane: Pane(Tabs),
            ),
            (
                size: "100%",
                pane: Split(direction: Horizontal, panes: [
                    (size: "1", pane: Pane(Empty())),
                    (size: "100%", pane: Pane(TabContent)),
                    (size: "1", pane: Pane(Empty())),
                ]),
            ),
            (
                size: "2",
                background_color: "#191919",
                borders: "TOP",
                border_symbols: Plain,
                border_style: (fg: "#303030"),
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (size: "15", pane: Component("footer_status")),
                        (size: "1", pane: Component("separator")),
                        (size: "100%", pane: Split(direction: Horizontal, panes: [
                            (size: "auto", pane: Component("footer_elapsed")),
                            (size: "100%", pane: Component("progress_bar")),
                            (size: "auto", pane: Component("footer_duration")),
                        ])),
                        (size: "1", pane: Component("separator")),
                        (size: "15", pane: Component("footer_queue")),
                    ]
                ),
            ),
        ],
    ),
    components: {
        "state": Pane(Property(
            content: [
                (kind: Text(" ")),
                (kind: Property(Status(StateV2(
                    playing_label: "PLAYING",
                    paused_label: "PAUSED",
                    stopped_label: "STOPPED",
                ))), style: (fg: "#a0a0a0")),
                (kind: Text(" ")),
            ], align: Center,
        )),
        "song_info": Pane(Property(
            content: [
                (
                    kind: Property(Song(Title)),
                    style: (fg: "#f2f2f2", modifiers: "Bold"),
                    default: (kind: Text("Nothing playing"), style: (fg: "#b0b0b0")),
                ),
                (
                    kind: Group([
                        (kind: Text(" · "), style: (fg: "#606060")),
                        (kind: Property(Song(Artist)), style: (fg: "#b0b0b0")),
                    ]),
                ),
                (
                    kind: Group([
                        (kind: Text(" · "), style: (fg: "#606060")),
                        (kind: Property(Song(Album)), style: (fg: "#858585")),
                    ]),
                ),
            ],
            align: Center,
            scroll_speed: 1,
        )),
        "now_playing": Pane(AlbumArt),
        "content_divider": Split(direction: Horizontal, panes: [
            (size: "1", pane: Pane(Empty())),
            (size: "1", borders: "LEFT", border_symbols: Plain,
                border_style: (fg: "#404040"), border_active_style: (fg: "#404040"),
                pane: Pane(Empty())),
            (size: "1", pane: Pane(Empty())),
        ]),
        "volume": Pane(Property(
            content: [
                (kind: Text(" ")),
                (kind: Text("VOL "), style: (fg: "#808080")),
                (kind: Property(Status(Volume)), style: (fg: "#b0b0b0")),
                (kind: Text("%"), style: (fg: "#b0b0b0")),
                (kind: Text(" ")),
            ], align: Center,
        )),
        "footer_status": Split(direction: Horizontal, panes: [
            (size: "1", pane: Pane(Empty())),
            (size: "6", pane: Component("input_mode")),
            (size: "1", pane: Pane(Empty())),
            (size: "6", pane: Component("states")),
            (size: "1", pane: Pane(Empty())),
        ]),
        "input_mode": Pane(Property(
            content: [
                (kind: Transform(Truncate(
                    content: (kind: Transform(Replace(
                        content: (kind: Property(Status(InputBuffer())), style: (fg: "#b0b0b0")),
                        replacements: [
                            (match: "", replace: (kind: Transform(Replace(
                                content: (kind: Property(Status(InputMode()))),
                                replacements: [
                                    (match: "Normal", replace: (kind: Text("NORMAL"), style: (fg: "#a0a0a0"))),
                                    (match: "Insert", replace: (kind: Text("INSERT"), style: (fg: "#eeeeee", modifiers: "Bold"))),
                                ],
                            )))),
                        ],
                    ))),
                    length: 6,
                    from_start: true,
                ))),
            ], align: Center,
        )),
        "states": Pane(Property(
            content: [
                (kind: Text("["), style: (fg: "#606060")),
                (kind: Property(Status(RepeatV2(
                    on_label: "z", off_label: "z",
                    on_style: (fg: "#eeeeee", modifiers: "Bold"),
                    off_style: (fg: "#606060"),
                )))),
                (kind: Property(Status(RandomV2(
                    on_label: "x", off_label: "x",
                    on_style: (fg: "#eeeeee", modifiers: "Bold"),
                    off_style: (fg: "#606060"),
                )))),
                (kind: Property(Status(ConsumeV2(
                    on_label: "c", off_label: "c", oneshot_label: "c",
                    on_style: (fg: "#eeeeee", modifiers: "Bold"),
                    off_style: (fg: "#606060"),
                    oneshot_style: (fg: "#eeeeee"),
                )))),
                (kind: Property(Status(SingleV2(
                    on_label: "v", off_label: "v", oneshot_label: "v",
                    on_style: (fg: "#eeeeee", modifiers: "Bold"),
                    off_style: (fg: "#606060"),
                    oneshot_style: (fg: "#eeeeee"),
                )))),
                (kind: Text("]"), style: (fg: "#606060")),
            ], align: Center
        )),
        "separator": Pane(Property(
            content: [(kind: Text("|"), style: (fg: "#404040"))],
            align: Center,
        )),
        "footer_elapsed": Pane(Property(
            content: [
                (kind: Text(" ")),
                (kind: Property(Status(Elapsed)), style: (fg: "#d4d4d4")),
                (kind: Text(" ")),
            ], align: Center,
        )),
        "footer_duration": Pane(Property(
            content: [
                (kind: Text(" ")),
                (kind: Property(Status(Duration)), style: (fg: "#909090")),
                (kind: Text(" ")),
            ], align: Center,
        )),
        "footer_queue": Pane(Property(
            content: [
                (kind: Text(" ")),
                (kind: Property(Status(QueueLength())), style: (fg: "#b0b0b0")),
                (kind: Text(" tracks"), style: (fg: "#909090")),
                (kind: Text(" ")),
            ], align: Center,
        )),
        "progress_bar": Pane(ProgressBar),
    },
)
